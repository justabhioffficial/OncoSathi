# =====================================================================
# OncoSathi AI - Environment Configuration
# =====================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# LLM Provider Configuration
# Options:
#   - "gemini": Uses Google Gemini API (set GEMINI_API_KEY below)
#   - "mock": Fully functional offline knowledge-grounded simplification engine (default, no keys required)
LLM_PROVIDER=mock

# Google Gemini API Key (Optional)
# Leave empty to run the built-in grounded offline engine
GEMINI_API_KEY=

# Retrieval Engine Configuration
SIMILARITY_THRESHOLD=0.08
TOP_K_CHUNKS=4
DEFAULT_LANGUAGE=english
DEFAULT_LEVEL=2
